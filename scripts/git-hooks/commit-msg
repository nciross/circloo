#!/usr/bin/env sh
# circloo: Conventional Commits + an issue reference. No issue, no development.
. "$(git rev-parse --show-toplevel)/scripts/git-hooks/_conventions.sh"

msg_file="$1"
# Merge commits from git merge/pull are not ours to name; they never reach main (squash only).
[ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0
# Ignore comment lines git adds to the editor buffer.
subject="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)"
body="$(grep -v '^#' "$msg_file")"

# Autosquash helpers are folded into a conventional commit before the branch is pushed.
case "$subject" in fixup!*|squash!*|amend!*) exit 0 ;; esac

ok=0
if ! conv_subject_ok "$subject"; then
  echo "✋ circloo: commit subject is not a Conventional Commit: \"$subject\"" >&2; ok=1
fi
if ! conv_issue_ok "$body"; then
  echo "✋ circloo: no issue, no development. Reference the issue (#N) in the commit message." >&2; ok=1
fi
[ $ok -eq 0 ] || { conv_commit_help; exit 1; }
