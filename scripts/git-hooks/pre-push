#!/usr/bin/env sh
# circloo: main only changes through squash-merged PRs. Pushed branches and commits must follow conventions.
. "$(git rev-parse --show-toplevel)/scripts/git-hooks/_conventions.sh"
zero='0000000000000000000000000000000000000000'

status=0; commit_fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch="${remote_ref#refs/heads/}"
  [ "$local_sha" = "$zero" ] && continue   # deleting a remote branch

  if [ "$branch" = "main" ]; then
    echo "✋ circloo: never push to main. Open a PR; Nicolas squash-merges it (/nicolas <PR#>)." >&2
    status=1; continue
  fi
  if ! conv_branch_ok "$branch"; then
    echo "✋ circloo: refusing to push branch '$branch'." >&2; conv_branch_help; status=1; continue
  fi

  # Check every new non-merge commit on the branch (relative to origin/main).
  range="origin/main..$local_sha"
  git rev-parse -q --verify origin/main >/dev/null || range="$local_sha"
  for c in $(git rev-list --no-merges "$range"); do
    msg="$(git log -1 --format=%B "$c")"
    subject="$(printf '%s\n' "$msg" | head -n1)"
    case "$subject" in
      fixup!*|squash!*|amend!*) echo "✋ circloo: $c is an unsquashed '$subject'. Run git rebase -i --autosquash first." >&2; status=1; continue ;;
    esac
    if ! conv_subject_ok "$subject" || ! conv_issue_ok "$msg"; then
      echo "✋ circloo: commit $(git rev-parse --short "$c") \"$subject\" breaks the commit convention." >&2
      status=1; commit_fail=1
    fi
  done
done
[ $commit_fail -eq 0 ] || conv_commit_help
exit $status
