{
  "lang": "ar",
  "dir": "rtl",
  "version": 2,
  "sparks": [
    {
      "id": "ar-ib-01",
      "kind": "icebreaker",
      "tone": "cozy",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "لو كان أسبوعك نشرة جوية، كيف سيكون الطقس؟"
    },
    {
      "id": "ar-ib-02",
      "kind": "icebreaker",
      "tone": "cozy",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "ما الشيء الصغير الذي جعلك تبتسم هذا الأسبوع؟"
    },
    {
      "id": "ar-ib-03",
      "kind": "icebreaker",
      "tone": "silly",
      "audiences": [
        "friends",
        "work"
      ],
      "kidsSafe": false,
      "text": "ما هي أكثر موهبة عندك بلا أي فائدة؟"
    },
    {
      "id": "ar-ib-04",
      "kind": "icebreaker",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "أيّ شخصية كرتونية ستكون أسوأ شريك سكن؟"
    },
    {
      "id": "ar-ib-05",
      "kind": "icebreaker",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "صِف صباحك بثلاثة رموز تعبيرية فقط."
    },
    {
      "id": "ar-ib-06",
      "kind": "icebreaker",
      "tone": "cozy",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": false,
      "text": "ما الأكلة التي أحببتها في طفولتك وما زلت تدافع عنها حتى اليوم؟"
    },
    {
      "id": "ar-ib-07",
      "kind": "icebreaker",
      "tone": "deep",
      "audiences": [
        "work"
      ],
      "kidsSafe": false,
      "text": "ما العادة أو الأداة التي توفّر لك ساعة كل أسبوع دون أن يلاحظ أحد؟"
    },
    {
      "id": "ar-ib-08",
      "kind": "icebreaker",
      "tone": "silly",
      "audiences": [
        "family"
      ],
      "kidsSafe": true,
      "text": "لو كانت لعائلتنا شارة مسلسل، فماذا ستكون؟"
    },
    {
      "id": "ar-ib-09",
      "kind": "icebreaker",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "يمكنك إتقان مهارة واحدة فورًا. أيّها تختار؟ ولماذا ليست مهارة مفيدة؟"
    },
    {
      "id": "ar-ib-10",
      "kind": "icebreaker",
      "tone": "deep",
      "audiences": [
        "friends",
        "work"
      ],
      "kidsSafe": false,
      "text": "ما أفضل نصيحة سمعتها ولم تعمل بها؟"
    },
    {
      "id": "ar-ib-11",
      "kind": "icebreaker",
      "tone": "cozy",
      "audiences": [
        "family",
        "friends"
      ],
      "kidsSafe": true,
      "text": "ما الرائحة التي تعيدك فورًا إلى أيام الطفولة؟"
    },
    {
      "id": "ar-ib-12",
      "kind": "icebreaker",
      "tone": "deep",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "ما الشيء الذي تعلّمته هذه السنة وفاجأك؟"
    },
    {
      "id": "ar-ib-13",
      "kind": "icebreaker",
      "tone": "silly",
      "audiences": [
        "work"
      ],
      "kidsSafe": true,
      "text": "لو كان لعملك مؤثر صوتي، فماذا سيكون؟"
    },
    {
      "id": "ar-ib-14",
      "kind": "icebreaker",
      "tone": "cozy",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "صِف يوم عطلتك المثالي، من الإفطار حتى النوم."
    },
    {
      "id": "ar-ib-15",
      "kind": "icebreaker",
      "tone": "deep",
      "audiences": [
        "family",
        "friends"
      ],
      "kidsSafe": true,
      "text": "من في هذه الدائرة علّمك شيئًا دون أن يدري؟"
    },
    {
      "id": "ar-ib-16",
      "kind": "icebreaker",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "أيّ غرض في البيت يستطيع إدارة اجتماع أفضل منا؟"
    },
    {
      "id": "ar-ib-17",
      "kind": "icebreaker",
      "tone": "cozy",
      "audiences": [
        "work"
      ],
      "kidsSafe": true,
      "text": "ما الإنجاز الصغير من الأسبوع الماضي الذي لم ينتبه له أحد؟"
    },
    {
      "id": "ar-ib-18",
      "kind": "icebreaker",
      "tone": "deep",
      "audiences": [
        "friends",
        "work"
      ],
      "kidsSafe": false,
      "text": "ماذا كنت ستجرّب لو كنت متأكدًا أنك لن تفشل؟"
    },
    {
      "id": "ar-wyr-01",
      "kind": "would-you-rather",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "هل تفضّل أن تتأخر دائمًا عشر دقائق أم أن تصل مبكرًا دائمًا بعشرين دقيقة؟"
    },
    {
      "id": "ar-wyr-02",
      "kind": "would-you-rather",
      "tone": "cozy",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "هل تفضّل أن تكلّم الحيوانات أم أن تتحدث كل لغات العالم؟"
    },
    {
      "id": "ar-wyr-03",
      "kind": "would-you-rather",
      "tone": "silly",
      "audiences": [
        "friends",
        "work"
      ],
      "kidsSafe": false,
      "text": "هل تفضّل قهوة بلا حدود أم قيلولة بلا حدود؟"
    },
    {
      "id": "ar-wyr-04",
      "kind": "would-you-rather",
      "tone": "silly",
      "audiences": [
        "family",
        "friends"
      ],
      "kidsSafe": true,
      "text": "هل تفضّل تنّينًا بحجم قطة أم قطة بحجم تنّين؟"
    },
    {
      "id": "ar-wyr-05",
      "kind": "would-you-rather",
      "tone": "cozy",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "هل تفضّل يومًا على شاطئ البحر أم يومًا في الجبال؟"
    },
    {
      "id": "ar-wyr-06",
      "kind": "would-you-rather",
      "tone": "silly",
      "audiences": [
        "work"
      ],
      "kidsSafe": true,
      "text": "هل تفضّل اجتماعات بالغناء أم رسائل بريد مكتوبة شعرًا؟"
    },
    {
      "id": "ar-wyr-07",
      "kind": "would-you-rather",
      "tone": "deep",
      "audiences": [
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "هل تفضّل أن تعيش أجمل أيامك مرة أخرى أم أن تعرف أن يومًا أجمل قادم؟"
    },
    {
      "id": "ar-wyr-08",
      "kind": "would-you-rather",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "هل تفضّل أن تهمس فقط أم أن تصرخ فقط طوال يوم كامل؟"
    },
    {
      "id": "ar-jk-01",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "قال الحاسوب لصاحبه: أنا متعب. فقال له: نَم قليلًا. فدخل في وضع السكون!"
    },
    {
      "id": "ar-jk-02",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "سأل المعلّم: من يذكر شيئًا مهمًّا لم يكن موجودًا قبل عشر سنوات؟ فرفع سامي يده وقال: أنا!"
    },
    {
      "id": "ar-jk-03",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "friends",
        "work"
      ],
      "kidsSafe": false,
      "text": "كان هذا الاجتماع يمكن أن يكون رسالة. والرسالة يمكن أن تكون ورقة لاصقة. والورقة اللاصقة صارت هذا الاجتماع."
    },
    {
      "id": "ar-jk-04",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "لماذا لا تلعب السمكة كرة السلة؟ لأنها تخاف من الشبكة!"
    },
    {
      "id": "ar-jk-05",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "ماذا قال القلم للممحاة؟ كلّما أخطأتُ، كنتِ بجانبي!"
    },
    {
      "id": "ar-jk-06",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "family",
        "friends"
      ],
      "kidsSafe": true,
      "text": "لماذا وضع الطالب السلّم في المدرسة؟ لأنه سمع أن الامتحان سيكون في مستوى عالٍ!"
    },
    {
      "id": "ar-jk-07",
      "kind": "joke",
      "tone": "cozy",
      "audiences": [
        "friends",
        "work"
      ],
      "kidsSafe": false,
      "text": "بيني وبين نباتاتي اتفاق: أنسى أن أسقيها، وتسامحني، ولا يتكلم أحد عن الموضوع."
    },
    {
      "id": "ar-jk-08",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "ماذا قالت الساعة للساعة الأخرى؟ دقيقة من فضلك!"
    },
    {
      "id": "ar-jk-09",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "work"
      ],
      "kidsSafe": true,
      "text": "سألني مديري: هل أنت مشغول؟ قلت: لا. فأصبحت مشغولًا."
    },
    {
      "id": "ar-jk-10",
      "kind": "joke",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "قال الطفل لأمه: أريد أن أصبح مثل القمر. قالت: لماذا؟ قال: لأنه يسهر كل ليلة ولا أحد يقول له: نَم!"
    },
    {
      "id": "ar-rd-01",
      "kind": "riddle",
      "tone": "deep",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "شيء كلما أخذت منه كبر. ما هو؟",
      "answer": "الحفرة."
    },
    {
      "id": "ar-rd-02",
      "kind": "riddle",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "له أسنان ولا يعضّ. ما هو؟",
      "answer": "المشط."
    },
    {
      "id": "ar-rd-03",
      "kind": "riddle",
      "tone": "cozy",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "يمشي بلا رجلين ويبكي بلا عينين. ما هو؟",
      "answer": "السحاب."
    },
    {
      "id": "ar-rd-04",
      "kind": "riddle",
      "tone": "silly",
      "audiences": [
        "family",
        "friends",
        "work"
      ],
      "kidsSafe": true,
      "text": "شيء يكتب ولا يقرأ. ما هو؟",
      "answer": "القلم."
    }
  ]
}
