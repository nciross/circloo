// circloo — all-in-one Azure deployment.
// Everything lives in ONE resource group (rg-circloo-<env>) so `azd down` / scripts/destroy removes it all.
targetScope = 'subscription'

@minLength(1)
@maxLength(32)
@description('Environment name (e.g. dev, prod). Used in the resource group name and resource names.')
param environmentName string

@minLength(1)
@description('Azure region for all resources.')
param location string

@secure()
@description('PostgreSQL administrator password. Generated by scripts/deploy if not provided.')
param postgresAdminPassword string

@secure()
@description('circloo security pepper (Security__Pepper): keys the HMAC of one-time codes, emails and IPs. Rotating it invalidates pending codes and audit hash matching. Generated by scripts/deploy if not provided.')
param authSecret string

@description('Container image for the web app. Left empty on first provision; azd deploy sets it.')
param webImageName string = ''

@description('Data location for Azure Communication Services (email).')
param communicationDataLocation string = 'Europe'

// ---------- Group calls (spec 009 T917, research R23, founder decision D8) ----------
// Each value below is set through an azd variable (azd env set NAME value). An empty value means "the default for
// this environment": the prod profile when environmentName is 'prod', the low-cost profile everywhere else.
@description('Create the group call server VM. False by default in every environment. azd: CALLS_ENABLED.')
param callsEnabled bool = false

@description('Call server VM size. Empty: Standard_B2als_v2 in prod, Standard_B2ats_v2 elsewhere. azd: CALLS_VM_SIZE.')
param callsVmSize string = ''

@allowed([ '', 'Standard_LRS', 'StandardSSD_LRS', 'Premium_LRS' ])
@description('Call server OS disk. Empty: StandardSSD_LRS in prod, Standard_LRS (Standard HDD) elsewhere. azd: CALLS_DISK_SKU.')
param callsDiskSku string = ''

@allowed([ '', 'true', 'false' ])
@description('A second static IP and name turn-<token> for TURN/TLS on 443. Empty: true in prod, false elsewhere. azd: CALLS_TURN_TLS.')
param callsTurnTls string = ''

@description('Daily auto-shutdown of the call server, HHmm Paris time (Romance Standard Time), or "off". Empty: off in prod, 2000 elsewhere. azd: CALLS_SHUTDOWN_TIME.')
param callsShutdownTime string = ''

@secure()
@description('LiveKit API secret (Key Vault secret livekit-api-secret). Generated by scripts/deploy (LIVEKIT_API_SECRET). Used only when callsEnabled.')
param liveKitApiSecret string = ''

@secure()
@description('Call server VM administrator password, required by Azure but never used (no SSH). Generated by scripts/deploy (CALLS_VM_PASSWORD). Used only when callsEnabled.')
param callsVmPassword string = ''

var isProd = environmentName == 'prod'
var calls = {
  vmSize: empty(callsVmSize) ? (isProd ? 'Standard_B2als_v2' : 'Standard_B2ats_v2') : callsVmSize
  diskSku: empty(callsDiskSku) ? (isProd ? 'StandardSSD_LRS' : 'Standard_LRS') : callsDiskSku
  turnTls: empty(callsTurnTls) ? isProd : callsTurnTls == 'true'
  shutdownTime: empty(callsShutdownTime) ? (isProd ? '' : '2000') : (toLower(callsShutdownTime) == 'off' ? '' : callsShutdownTime)
}

var resourceGroupName = 'rg-circloo-${environmentName}'
var token = toLower(uniqueString(subscription().id, environmentName, location))
var tags = {
  'azd-env-name': environmentName
  app: 'circloo'
}

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: resourceGroupName
  location: location
  tags: tags
}

module app 'modules/app.bicep' = {
  name: 'circloo-app'
  scope: rg
  params: {
    location: location
    tags: tags
    token: token
    postgresAdminPassword: postgresAdminPassword
    authSecret: authSecret
    webImageName: webImageName
    communicationDataLocation: communicationDataLocation
    callsEnabled: callsEnabled
    callsVmSize: calls.vmSize
    callsDiskSku: calls.diskSku
    callsTurnTls: calls.turnTls
    callsShutdownTime: calls.shutdownTime
    liveKitApiSecret: liveKitApiSecret
    callsVmPassword: callsVmPassword
  }
}

output AZURE_RESOURCE_GROUP string = rg.name
output AZURE_LOCATION string = location
output AZURE_CONTAINER_REGISTRY_ENDPOINT string = app.outputs.registryLoginServer
output AZURE_CONTAINER_REGISTRY_NAME string = app.outputs.registryName
output AZURE_KEY_VAULT_NAME string = app.outputs.keyVaultName
output WEB_URI string = app.outputs.webUri
output EMAIL_SENDER_ADDRESS string = app.outputs.emailSender
// Group calls: empty when callsEnabled is false. scripts/deploy and scripts/calls-start start CALLS_VM_NAME.
output LIVEKIT_URL string = app.outputs.liveKitUrl
output CALLS_VM_NAME string = app.outputs.callsVmName
