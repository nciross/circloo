// The group call server (spec 009 T917, research R23, founder decision D8): one small Linux VM running the pinned
// LiveKit image behind Caddy, deployed by app.bicep only when callsEnabled is true. It stores nothing and is rebuilt
// from cloud-init rather than repaired; scripts/destroy removes it with the resource group.
// Accepted exception to "one production container" and to VII's preference for managed services (constitution 2.1.0).
param location string
param tags object
param token string

@description('VM size. Defaults per environment in main.bicep (callsVmSize).')
param vmSize string

@allowed([ 'Standard_LRS', 'StandardSSD_LRS', 'Premium_LRS' ])
@description('OS disk type. Defaults per environment in main.bicep (callsDiskSku).')
param diskSku string

@description('A second static IP and name turn-<token> for TURN/TLS on 443 (callsTurnTls).')
param turnTls bool

@description('Daily auto-shutdown time, HHmm in Romance Standard Time (Paris). Empty: never shut down.')
param shutdownTime string

@secure()
@minLength(32)
@description('LiveKit API secret, stored here as Key Vault secret livekit-api-secret. Generated by scripts/deploy (LIVEKIT_API_SECRET).')
param apiSecret string

@description('LiveKit API key id (not a secret).')
param apiKey string

@description('Administrator account Azure requires for a Linux VM. Never used: no SSH.')
param adminUsername string = 'circlooadmin'

@secure()
@minLength(12)
@description('Administrator password Azure requires for a Linux VM. Never used: no SSH. Generated by scripts/deploy (CALLS_VM_PASSWORD).')
param adminPassword string

@description('Name of the environment Key Vault (app.bicep).')
param vaultName string

@description('Where LiveKit posts its webhooks: https://<web app>/api/livekit/webhook.')
param webhookUrl string

var lkLabel = 'lk-${token}'
var turnLabel = 'turn-${token}'
var addressSpace = '10.40.0.0/24'
var subnetPrefix = '10.40.0.0/27'
var primaryPrivateIp = '10.40.0.4' // the first usable address of the subnet
var turnPrivateIp = '10.40.0.5'

// LiveKit's TURN relay ports (turn.relay_range_* in infra/livekit/livekit.yaml). Open only to the VM's own public IP.
var relayPorts = '30000-40000'

// ---------- Network: one subnet, an NSG with only the call ports, static public IPs with DNS labels ----------
resource nsg 'Microsoft.Network/networkSecurityGroups@2024-05-01' = {
  name: 'nsg-circloo-${token}'
  location: location
  tags: tags
  properties: {
    // Only these four from the internet; everything else (SSH included) hits the default DenyAllInBound rule.
    securityRules: [
      {
        name: 'allow-https-tcp-443'
        properties: {
          description: 'Signalling (WebSocket and Twirp) and TURN/TLS, TLS terminated by Caddy'
          priority: 100
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: 'Internet'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '443'
        }
      }
      {
        name: 'allow-ice-tcp-7881'
        properties: {
          description: 'ICE over TCP when UDP is blocked'
          priority: 110
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: 'Internet'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '7881'
        }
      }
      {
        name: 'allow-media-udp-7882'
        properties: {
          description: 'Media over UDP (one muxed port)'
          priority: 120
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Udp'
          sourceAddressPrefix: 'Internet'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '7882'
        }
      }
      {
        name: 'allow-turn-udp-3478'
        properties: {
          description: 'TURN over UDP'
          priority: 130
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Udp'
          sourceAddressPrefix: 'Internet'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '3478'
        }
      }
      {
        // Not from the internet: TURN relays a browser's media to the call server at the VM's public IP, and Azure
        // routes a VM's traffic to its own public IP out and back in through this NSG, so the server's answers to
        // the relay ports arrive from that one address.
        name: 'allow-turn-relay-from-itself'
        properties: {
          description: 'TURN relay ports, from the VM own public IP only'
          priority: 140
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Udp'
          sourceAddressPrefix: '${lkIp.properties.ipAddress}/32'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: relayPorts
        }
      }
    ]
  }
}

resource vnet 'Microsoft.Network/virtualNetworks@2024-05-01' = {
  name: 'vnet-circloo-${token}'
  location: location
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: [ addressSpace ] }
    subnets: [
      {
        name: 'calls'
        properties: {
          addressPrefix: subnetPrefix
          networkSecurityGroup: { id: nsg.id }
          // Outbound (Let's Encrypt, image pulls, Key Vault, updates) goes through the VM's own public IP.
          defaultOutboundAccess: false
        }
      }
    ]
  }
}

// Standard static IPs (Basic is retired). They keep costing while the VM is deallocated: the floor of the dev profile.
resource lkIp 'Microsoft.Network/publicIPAddresses@2024-05-01' = {
  name: 'pip-circloo-${token}'
  location: location
  tags: tags
  sku: { name: 'Standard', tier: 'Regional' }
  properties: {
    publicIPAllocationMethod: 'Static'
    publicIPAddressVersion: 'IPv4'
    dnsSettings: { domainNameLabel: lkLabel }
  }
}

resource turnIp 'Microsoft.Network/publicIPAddresses@2024-05-01' = if (turnTls) {
  name: 'pip-circloo-turn-${token}'
  location: location
  tags: tags
  sku: { name: 'Standard', tier: 'Regional' }
  properties: {
    publicIPAllocationMethod: 'Static'
    publicIPAddressVersion: 'IPv4'
    dnsSettings: { domainNameLabel: turnLabel }
  }
}

var subnetId = vnet.properties.subnets[0].id
var lkIpConfig = {
  name: 'lk'
  properties: {
    primary: true
    privateIPAllocationMethod: 'Static'
    privateIPAddress: primaryPrivateIp
    subnet: { id: subnetId }
    publicIPAddress: { id: lkIp.id }
  }
}

resource nic 'Microsoft.Network/networkInterfaces@2024-05-01' = {
  name: 'nic-circloo-${token}'
  location: location
  tags: tags
  properties: {
    // The NSG is on the subnet, the only one this NIC uses.
    ipConfigurations: turnTls ? [
      lkIpConfig
      {
        name: 'turn'
        properties: {
          primary: false
          privateIPAllocationMethod: 'Static'
          privateIPAddress: turnPrivateIp
          subnet: { id: subnetId }
          publicIPAddress: { id: turnIp!.id }
        }
      }
    ] : [ lkIpConfig ]
  }
}

// ---------- The API secret, read by the VM's identity at boot and by the web app as a secret reference ----------
resource vault 'Microsoft.KeyVault/vaults@2023-07-01' existing = {
  name: vaultName
}

resource secret 'Microsoft.KeyVault/vaults/secrets@2023-07-01' = {
  parent: vault
  name: 'livekit-api-secret'
  properties: { value: apiSecret }
}

// ---------- The VM ----------
var lkFqdn = lkIp.properties.dnsSettings.fqdn
var turnFqdn = turnTls ? turnIp!.properties.dnsSettings.fqdn : ''

// infra/livekit/livekit.yaml with its placeholders filled, then placed inside the boot script.
var liveKitYaml = replace(replace(replace(replace(replace(replace(loadTextContent('../livekit/livekit.yaml'),
  '\${NODE_IP}', lkIp.properties.ipAddress),
  '\${TURN_TLS_PORT}', turnTls ? '5349' : '0'),
  '\${TURN_DOMAIN}', turnFqdn),
  '\${API_KEY}', apiKey),
  '\${WEBHOOK_URL}', webhookUrl),
  '\r', '')

var bootScript = replace(replace(replace(replace(replace(replace(replace(loadTextContent('../livekit/boot.sh'),
  '__LK_DOMAIN__', lkFqdn),
  '__TURN_DOMAIN__', turnFqdn),
  '__TURN_PRIVATE_IP__', turnTls ? turnPrivateIp : ''),
  '__VAULT_URI__', vault.properties.vaultUri),
  '__API_KEY__', apiKey),
  '__LIVEKIT_YAML__', liveKitYaml),
  '\r', '')

resource vm 'Microsoft.Compute/virtualMachines@2024-07-01' = {
  name: 'vm-circloo-${token}'
  location: location
  tags: tags
  identity: { type: 'SystemAssigned' }
  properties: {
    hardwareProfile: { vmSize: vmSize }
    storageProfile: {
      imageReference: {
        publisher: 'Canonical'
        offer: 'ubuntu-24_04-lts'
        sku: 'server'
        version: 'latest'
      }
      osDisk: {
        name: 'osdisk-circloo-${token}'
        createOption: 'FromImage'
        diskSizeGB: 32
        managedDisk: { storageAccountType: diskSku }
        deleteOption: 'Delete'
      }
    }
    osProfile: {
      computerName: 'circloo-calls'
      adminUsername: adminUsername
      adminPassword: adminPassword
      // First boot only, and Azure cannot change it later: kept free of anything deployment-specific.
      customData: base64(replace(loadTextContent('../livekit/cloud-init.yaml'), '\r', ''))
      linuxConfiguration: {
        disablePasswordAuthentication: false // Azure needs a password or a key; sshd is masked and the NSG has no SSH rule
        provisionVMAgent: true
        patchSettings: {
          // In-guest unattended-upgrades (cloud-init.yaml) installs security updates every day.
          patchMode: 'ImageDefault'
          assessmentMode: 'ImageDefault'
        }
      }
    }
    // Read by circloo-calls.service at every boot; a deployment can update it (applied at the next start).
    userData: base64(bootScript)
    networkProfile: {
      networkInterfaces: [
        { id: nic.id, properties: { primary: true, deleteOption: 'Delete' } }
      ]
    }
    securityProfile: {
      securityType: 'TrustedLaunch'
      uefiSettings: { secureBootEnabled: true, vTpmEnabled: true }
    }
  }
}

// Least privilege: the VM may read this one secret, nothing else in the vault.
var kvSecretsUserRoleId = '4633458b-17de-408a-b874-0445c86b69e6'
resource vmReadsSecret 'Microsoft.Authorization/roleAssignments@2022-04-01' = {
  name: guid(secret.id, vm.id, kvSecretsUserRoleId)
  scope: secret
  properties: {
    principalId: vm.identity.principalId
    principalType: 'ServicePrincipal'
    roleDefinitionId: subscriptionResourceId('Microsoft.Authorization/roleDefinitions', kvSecretsUserRoleId)
  }
}

// Nightly stop outside production (DevTest Labs auto-shutdown deallocates the VM, which stops the compute bill).
// The name is the one the portal expects for a VM's auto-shutdown.
resource shutdown 'Microsoft.DevTestLab/schedules@2018-09-15' = if (!empty(shutdownTime)) {
  name: 'shutdown-computevm-${vm.name}'
  location: location
  tags: tags
  properties: {
    status: 'Enabled'
    taskType: 'ComputeVmShutdownTask'
    dailyRecurrence: { time: shutdownTime }
    timeZoneId: 'Romance Standard Time'
    notificationSettings: { status: 'Disabled' }
    targetResourceId: vm.id
  }
}

output vmName string = vm.name
output fqdn string = lkFqdn
output url string = 'wss://${lkFqdn}'
output apiUrl string = 'https://${lkFqdn}'
output secretUri string = secret.properties.secretUri
